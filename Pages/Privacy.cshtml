@page
@model PrivacyModel
@{
    ViewData["Title"] = "Privacy Policy";
}
<section class="vpms-legal-page mx-auto">
    <div class="vpms-page-heading">
        <div>
            <div class="vpms-section-eyebrow">Guest information</div>
            <h1>@ViewData["Title"]</h1>
            <p>How @Model.ControllerName handles personal information submitted through this PMS.</p>
        </div>
    </div>

    @if (Model.HasPublishedNotice)
    {
        <article class="card vpms-legal-card">
            <div class="card-body">
                <p class="text-muted mb-4">This notice is supplied by the hotel. For a request concerning your information, contact the hotel directly@(string.IsNullOrWhiteSpace(Model.ContactEmail) ? "." : $" at {Model.ContactEmail}.")</p>
                <div class="vpms-legal-copy">@Model.PrivacyPolicy</div>
            </div>
        </article>
    }
    else
    {
        <div class="alert alert-warning" role="alert">
            <h2 class="h5">Privacy notice not yet published</h2>
            <p class="mb-0">The hotel must publish a reviewed privacy notice and a data-protection contact before accepting personal information through public booking or guest-portal forms.</p>
        </div>
    }
</section>
